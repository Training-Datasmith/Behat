includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        -
            identifier: class.notFound
            paths:
                - src/Behat/Testwork/Exception/Stringer/PHP_Unit_Exception_Stringer.php
        -
            identifier: constructor.unusedParameter
            paths:
                - src/Behat/Behat/Definition/Printer/Console_Definition_Printer.php
                - src/Behat/Behat/Output/Node/Printer/J_Unit/J_Unit_Scenario_Printer.php
                - src/Behat/Behat/Output/Node/Printer/List_Printer.php
                - src/Behat/Behat/Transformation/Transformation/Return_Type_Transformation.php
                - src/Behat/Testwork/Ordering/Cli/Order_Controller.php
